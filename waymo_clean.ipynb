        "# -----------------------------------------------------------------\n",
        "# CELL 3: DEFINE PIPELINE FUNCTIONS\n",
        "# Run this cell to load all functions into memory\n",
        "# Nothing is going to execute here, the functions run in Cell 4\n",
        "# -----------------------------------------------------------------\n",
        "\n",
        "def rolling_buffer_pipeline(start_file, end_file, output_dir):\n",
        "    \"\"\"\n",
        "    This function will read the assigned TFRecord files once it is in sequential order.\n",
        "    Detecting edge cases, using a rolling buffer.\n",
        "    Saves the front camera JPEGs around each of the detected events.\n",
        "    Saving all the frame features to a parquet file.\n",
        "    Returning a dataframe of all the frames.\n",
        "    \"\"\"\n",
        "\n",
        "    # Build GCS file paths for assigned the files\n",
        "    filenames = [\n",
        "        f'gs://waymo_open_dataset_end_to_end_camera_v_1_0_0/'\n",
        "        f'training_202504031202_202504151040.tfrecord-{str(i).zfill(5)}-of-00263'\n",
        "        for i in range(start_file, end_file)\n",
        "    ]\n",
        "    print(f'Person {PERSON_ID}: processing {len(filenames)} files')\n",
        "\n",
        "    # num_parallel_reads=1 is required as the frames must arrive in order,\n",
        "    # for the rolling buffer to capture consecutive frames correctly\n",
        "    dataset = tf.data.TFRecordDataset(filenames, compression_type='', num_parallel_reads=1)\n",
        "\n",
        "    # The proto stores intent as an integer (0, 1, 2...)\n",
        "    # These two lines build a lookup list so we can convert\n",
        "    # that integer into a readable label such as GO_STRAIGHT or GO_LEFT\n",
        "    # Used later as: intent_list[e2e.intent] -> 'GO_STRAIGHT'\n",
        "    intent_map  = dict(e2e_pb2.EgoIntent.Intent.items())\n",
        "    intent_list = [k for k, v in intent_map.items()]\n",
        "\n",
        "    rows          = []                                                    # parquet rows\n",
        "    frame_buffers = defaultdict(lambda: deque(maxlen=FRAME_BUFFER_SIZE))  # rolling buffer per segment\n",
        "    active_events = defaultdict(int)                                      # post-event countdown per segment\n",
        "    saved_images  = set()                                                 # prevents duplicate writes\n",
        "    flagged_segs  = set()                                                 # segments with any detected event\n",
        "    frames_seen   = 0\n",
        "    images_saved  = 0\n",
        "    edge_cases    = 0\n",
        "\n",
        "    for raw in dataset:\n",
        "        frames_seen += 1\n",
        "        if frames_seen % 1000 == 0:\n",
        "            print(f'  {frames_seen} frames | {edge_cases} edge cases | {images_saved} images saved')\n",
        "\n",
        "        # Parse the raw bytes into a structured proto object\n",
        "        e2e        = e2e_pb2.E2EDFrame()\n",
        "        e2e.ParseFromString(raw.numpy())\n",
        "        frame_id   = e2e.frame.context.name\n",
        "        segment_id = frame_id.split('-')[0]\n",
        "        frame_idx  = int(frame_id.split('-')[1])\n",
        "\n",
        "        # Get front camera image bytes only (camera name 1 = FRONT)\n",
        "        front_image = None\n",
        "        for img_proto in e2e.frame.images:\n",
        "            if img_proto.name == 1:\n",
        "                front_image = img_proto.image\n",
        "                break\n",
        "\n",
        "        # Extract motion features from past states history\n",
        "        angular_v, angular_y, angular_z = [], [], []\n",
        "        for img_proto in e2e.frame.images:\n",
        "            v = img_proto.velocity\n",
        "            angular_v.append(np.sqrt(v.w_x**2 + v.w_y**2 + v.w_z**2))\n",
        "            angular_y.append(v.w_y)\n",
        "            angular_z.append(v.w_z)\n",
        "\n",
        "        vx    = np.array(e2e.past_states.vel_x)\n",
        "        vy    = np.array(e2e.past_states.vel_y)\n",
        "        ax    = np.array(e2e.past_states.accel_x)\n",
        "        ay    = np.array(e2e.past_states.accel_y)\n",
        "        speed = np.sqrt(vx**2 + vy**2)\n",
        "\n",
        "        long_acc = float(np.max(np.abs(ax)))\n",
        "        lat_acc  = float(np.max(np.abs(ay)))\n",
        "        jerk     = float(np.max(np.abs(np.diff(ax))) if len(ax) > 1 else 0)\n",
        "\n",
        "        # Add frame to rolling buffer, the oldest frame dropped automatically when full\n",
        "        frame_buffers[segment_id].append({\n",
        "            'frame_idx': frame_idx, 'image_bytes': front_image,\n",
        "            'long_acc': long_acc, 'lat_acc': lat_acc, 'jerk': jerk,\n",
        "        })\n",
        "        buf          = list(frame_buffers[segment_id])\n",
        "        rolling_long = np.mean([f['long_acc'] for f in buf])\n",
        "        rolling_lat  = np.mean([f['lat_acc']  for f in buf])\n",
        "        rolling_jerk = np.mean([f['jerk']     for f in buf])\n",
        "\n",
        "        # HIGH SEVERITY: extreme single-frame event\n",
        "        # Emergency brake alone always flags\n",
        "        # Hard brake + lateral = braking while turning\n",
        "        # Hard brake + jerk = sudden unexpected movement\n",
        "        # AGGREGATION?\n",
        "        is_high = (\n",
        "            long_acc >= EMERGENCY_BRAKE or\n",
        "            (long_acc >= HARD_BRAKE_THRESHOLD and lat_acc >= HIGH_LAT_THRESHOLD) or\n",
        "            (long_acc >= HARD_BRAKE_THRESHOLD and jerk    >= HIGH_JERK_THRESHOLD)\n",
        "        )\n",
        "\n",
        "        # MEDIUM SUSTAINED: both signals elevated over the rolling window\n",
        "        # Requires both to be high together which might reduce false positives\n",
        "        is_medium = (\n",
        "            (rolling_long >= SUSTAINED_BRAKE_SHORT  and rolling_lat  >= SUSTAINED_LATERAL_SHORT) or\n",
        "            (rolling_long >= SUSTAINED_BRAKE_MEDIUM and rolling_jerk >= SUSTAINED_JERK_MEDIUM)\n",
        "        )\n",
        "\n",
        "        is_peak      = is_high and is_medium   # both methods agree = highest confidence\n",
        "        is_edge_case = is_high or is_medium\n",
        "\n",
        "        # ---- SAVE IMAGES ----\n",
        "        seg_dir = f'{output_dir}/images/{segment_id}/FRONT'\n",
        "\n",
        "        if is_edge_case:\n",
        "            # New edge case detected, flush buffer to disk for pre-event context\n",
        "            flagged_segs.add(segment_id)\n",
        "            os.makedirs(seg_dir, exist_ok=True)\n",
        "            for bf in buf:\n",
        "                if bf['image_bytes'] is None: continue\n",
        "                p = f'{seg_dir}/camera_image_{bf[\"frame_idx\"]:04d}.jpg'\n",
        "                if p not in saved_images:\n",
        "                    with open(p, 'wb') as f: f.write(bf['image_bytes'])\n",
        "                    saved_images.add(p); images_saved += 1\n",
        "            active_events[segment_id] = POST_EVENT_FRAMES\n",
        "            edge_cases += 1\n",
        "\n",
        "        elif segment_id in flagged_segs:\n",
        "            # Segment already had an event, save every subsequent frame\n",
        "            # This fills gaps between back-to-back events in the same segment\n",
        "            if front_image:\n",
        "                os.makedirs(seg_dir, exist_ok=True)\n",
        "                p = f'{seg_dir}/camera_image_{frame_idx:04d}.jpg'\n",
        "                if p not in saved_images:\n",
        "                    with open(p, 'wb') as f: f.write(front_image)\n",
        "                    saved_images.add(p); images_saved += 1\n",
        "\n",
        "        elif active_events[segment_id] > 0:\n",
        "            # Still in the post-event window — keep saving\n",
        "            if front_image:\n",
        "                os.makedirs(seg_dir, exist_ok=True)\n",
        "                p = f'{seg_dir}/camera_image_{frame_idx:04d}.jpg'\n",
        "                if p not in saved_images:\n",
        "                    with open(p, 'wb') as f: f.write(front_image)\n",
        "                    saved_images.add(p); images_saved += 1\n",
        "            active_events[segment_id] -= 1\n",
        "\n",
        "        rows.append({\n",
        "            'frame_id': frame_id, 'segment_id': segment_id, 'frame_idx': frame_idx,\n",
        "            'person_id': PERSON_ID, 'intent': intent_list[e2e.intent],\n",
        "            'mean_speed': float(np.mean(speed)), 'min_speed': float(np.min(speed)),\n",
        "            'max_long_acc': long_acc, 'max_lat_acc': lat_acc, 'jerk': jerk,\n",
        "            'mean_angular_velocity': float(np.mean(angular_v)) if angular_v else 0,\n",
        "            'max_angular_velocity':  float(np.max(angular_v)) if angular_v else 0,\n",
        "            'pitch_rate':            float(np.mean(angular_y)) if angular_y else 0,\n",
        "            'max_angular_yaw':       float(np.max(angular_z)) if angular_z else 0,\n",
        "            'rolling_long_acc': rolling_long, 'rolling_lat_acc': rolling_lat,\n",
        "            'rolling_jerk': rolling_jerk, 'is_high_severity': is_high,\n",
        "            'is_medium_sustained': is_medium, 'is_peak_long_tail': is_peak,\n",
        "            'is_edge_case': is_edge_case,\n",
        "        })\n",
        "\n",
        "    df    = pd.DataFrame(rows)\n",
        "    total = len(df)\n",
        "    df.to_parquet(f'{output_dir}/parquets/all_frames_person_{PERSON_ID}.parquet', index=False)\n",
        "    df[df['is_edge_case']].to_parquet(f'{output_dir}/parquets/edge_cases_person_{PERSON_ID}.parquet', index=False)\n",
        "\n",
        "    print(f'\\nDone — {total:,} frames | {images_saved} images | {len(flagged_segs)} flagged segments')\n",
        "    print(f'  High severity:  {df[\"is_high_severity\"].sum()} ({df[\"is_high_severity\"].sum()/total*100:.1f}%)')\n",
        "    print(f'  Peak long tail: {df[\"is_peak_long_tail\"].sum()} ({df[\"is_peak_long_tail\"].sum()/total*100:.1f}%)')\n",
        "    return df\n",
        "\n",
        "\n",
        "def make_gifs_from_saved_images(output_dir):\n",
        "    \"\"\"\n",
        "    Reads the JPEGs saved by the rolling buffer pipeline and stitches them into GIFs.\n",
        "    Sorts the frames numerically so playback is in the correct order.\n",
        "    Skips segments with fewer than the defined MIN_GIF_FRAMES images.\n",
        "    \"\"\"\n",
        "    os.makedirs(f'{output_dir}/gifs', exist_ok=True)\n",
        "    seg_dirs     = glob.glob(f'{output_dir}/images/*/FRONT')\n",
        "    gifs_saved   = 0\n",
        "    gifs_skipped = 0\n",
        "\n",
        "    for seg_dir in sorted(seg_dirs):\n",
        "        segment_id   = seg_dir.split('/')[-2]\n",
        "        image_paths  = sorted(\n",
        "            glob.glob(f'{seg_dir}/camera_image_*.jpg'),\n",
        "            key=lambda x: int(os.path.splitext(os.path.basename(x))[0].replace('camera_image_', ''))\n",
        "        )\n",
        "        if len(image_paths) < MIN_GIF_FRAMES:\n",
        "            gifs_skipped += 1; continue\n",
        "\n",
        "        frames   = [Image.open(p) for p in image_paths]\n",
        "        gif_path = f'{output_dir}/gifs/{segment_id}.gif'\n",
        "        frames[0].save(gif_path, save_all=True, append_images=frames[1:], duration=100, loop=0)\n",
        "        print(f'  Saved {segment_id[-8:]}... — {len(frames)} frames')\n",
        "        gifs_saved += 1\n",
        "\n",
        "    print(f'\\n{gifs_saved} GIFs saved, {gifs_skipped} skipped (too short)')\n",
        "\n",
        "\n",
        "print('Functions defined — ready to run Cell 4')"
      ]
    },
