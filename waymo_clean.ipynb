        "# ---------------------------------------------------------------------\n",
        "# CELL 9: BUILD SMOOTH GIFS\n",
        "# Uses frames collected in Cell 8 to build presentation-quality GIFs\n",
        "# Each GIF shows 10 seconds of context before and after the edge case\n",
        "# GIF filename includes segment ID, duration, and severity for easy reference\n",
        "# ---------------------------------------------------------------------\n",
        "\n",
        "os.makedirs(f'{OUTPUT_DIR}/gifs_smooth', exist_ok=True)\n",
        "\n",
        "print(f'Building smooth GIFs...')\n",
        "print(f'  Min frames:  {MIN_CONSECUTIVE_FRAMES} ({MIN_CONSECUTIVE_FRAMES/10:.0f} sec)')\n",
        "print(f'  Context:     {CONTEXT_BEFORE} before + {CONTEXT_AFTER} after ({(CONTEXT_BEFORE+CONTEXT_AFTER)/10:.0f} sec total)\\n')\n",
        "\n",
        "gifs_saved   = 0\n",
        "gifs_skipped = 0\n",
        "\n",
        "for segment_id, frames in segment_frame_buffer.items():\n",
        "    if not frames:\n",
        "        print(f'  SKIPPED {segment_id[-8:]}... — no frames collected')\n",
        "        gifs_skipped += 1\n",
        "        continue\n",
        "\n",
        "    # Sort collected frames chronologically\n",
        "    frames = sorted(frames, key=lambda x: x['frame_idx'])\n",
        "\n",
        "    # Get the flagged frame indices from the merged dataframe\n",
        "    flagged_indices = df[\n",
        "        (df['segment_id'] == segment_id) & (df['is_edge_case'])\n",
        "    ]['frame_idx'].tolist()\n",
        "\n",
        "    if not flagged_indices:\n",
        "        print(f'  SKIPPED {segment_id[-8:]}... — no flagged frames in df')\n",
        "        gifs_skipped += 1\n",
        "        continue\n",
        "\n",
        "    # Build window: context before earliest flag to context after latest flag\n",
        "    window_start  = min(flagged_indices) - CONTEXT_BEFORE\n",
        "    window_end    = max(flagged_indices) + CONTEXT_AFTER\n",
        "    window_frames = [f for f in frames if window_start <= f['frame_idx'] <= window_end]\n",
        "\n",
        "    if len(window_frames) < MIN_CONSECUTIVE_FRAMES:\n",
        "        print(f'  SKIPPED {segment_id[-8:]}... — only {len(window_frames)} frames in window (need {MIN_CONSECUTIVE_FRAMES})')\n",
        "        gifs_skipped += 1\n",
        "        continue\n",
        "\n",
        "    # Check for large gaps — GIF must be truly consecutive footage\n",
        "    w_indices = [f['frame_idx'] for f in window_frames]\n",
        "    max_gap   = max([w_indices[i+1] - w_indices[i] for i in range(len(w_indices)-1)], default=0)\n",
        "    if max_gap > MAX_ALLOWED_GAP:\n",
        "        print(f'  SKIPPED {segment_id[-8:]}... — max gap {max_gap} (frames not consecutive enough)')\n",
        "        gifs_skipped += 1\n",
        "        continue\n",
        "\n",
        "    # Save images and stitch GIF\n",
        "    seg_dir = f'{OUTPUT_DIR}/images_smooth/{segment_id}/FRONT'\n",
        "    os.makedirs(seg_dir, exist_ok=True)\n",
        "    for frame in window_frames:\n",
        "        if frame['image_bytes'] is None: continue\n",
        "        with open(f'{seg_dir}/camera_image_{frame[\"frame_idx\"]:04d}.jpg', 'wb') as f:\n",
        "            f.write(frame['image_bytes'])\n",
        "\n",
        "    image_paths = sorted(\n",
        "        glob.glob(f'{seg_dir}/camera_image_*.jpg'),\n",
        "        key=lambda x: int(os.path.splitext(os.path.basename(x))[0].replace('camera_image_', ''))\n",
        "    )\n",
        "    if len(image_paths) < MIN_CONSECUTIVE_FRAMES:\n",
        "        gifs_skipped += 1; continue\n",
        "\n",
        "    frames_imgs  = [Image.open(p) for p in image_paths]\n",
        "    seg_df       = df[df['segment_id'] == segment_id]\n",
        "    seg_severity = seg_df['max_long_acc'].max()\n",
        "    seg_lat      = seg_df['max_lat_acc'].max()\n",
        "    seg_intent   = seg_df['intent'].value_counts().index[0]\n",
        "    duration_sec = len(frames_imgs) / 10\n",
        "    label        = 'PEAK' if seg_df['is_peak_long_tail'].any() else 'HIGH'\n",
        "\n",
        "    gif_path = (\n",
        "        f'{OUTPUT_DIR}/gifs_smooth/'\n",
        "        f'[{label}]_{segment_id}_'\n",
        "        f'{len(frames_imgs)}frames_{duration_sec:.1f}sec_'\n",
        "        f'lat{seg_lat:.2f}_long{seg_severity:.2f}.gif'\n",
        "    )\n",
        "    frames_imgs[0].save(gif_path, save_all=True, append_images=frames_imgs[1:], duration=100, loop=0)\n",
        "\n",
        "    print(f'  [{label}] {segment_id[-8:]}... | {len(frames_imgs)} frames ({duration_sec:.1f}s) | '\n",
        "          f'lat: {seg_lat:.3f} | long: {seg_severity:.3f} | intent: {seg_intent}')\n",
        "    gifs_saved += 1\n",
        "\n",
        "print(f'\\nDone — {gifs_saved} GIFs saved, {gifs_skipped} skipped')\n",
        "print(f'Location: {OUTPUT_DIR}/gifs_smooth/')"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------------------------------------------------------------\n",
        "# CELL 10: SEVERITY SCORING + EVENT CLASSIFICATION + DASHBOARD\n",
        "# Aesthetic: colored palette\n",
        "# ---------------------------------------------------------------------\n",
        "# Install dashboard dependencies first\n",
        "!pip install dash dash-bootstrap-components --quiet\n",
        "import duckdb\n",
        "import dash\n",
        "from dash import dcc, html, dash_table\n",
        "import dash_bootstrap_components as dbc\n",
        "import plotly.express as px\n",
        "import plotly.graph_objects as go\n",
        "import threading\n",
        "import time\n",
        "\n",
        "# ---- STEP 1: SEVERITY SCORING ----\n",
        "df['compound_score'] = (\n",
        "    df['max_long_acc'] * 0.45 +\n",
        "    df['max_lat_acc']  * 0.45 +\n",
        "    df['jerk']         * 0.10\n",
        ")\n",
        "threshold           = df['compound_score'].quantile(0.98)\n",
        "df['is_anomaly']    = df['compound_score'] >= threshold\n",
        "df['anomaly_score'] = df['compound_score']\n",
        "\n",
        "print(f'Severity threshold (98th pct): {threshold:.4f}')\n",
        "print(f'Flagged anomalies: {df[\"is_anomaly\"].sum():,}')\n",
        "\n",
        "# ---- STEP 2: EVENT CLASSIFIER ----\n",
        "def classify_event(row):\n",
        "    if row['max_long_acc'] >= 0.8 and row['max_lat_acc'] < 0.3:\n",
        "        return 'HARD_BRAKE'\n",
        "    elif row['max_lat_acc'] >= 0.6 and row['intent'] == 'GO_STRAIGHT':\n",
        "        return 'UNEXPECTED_SWERVE'\n",
        "    elif row['max_lat_acc'] >= 0.5 and row['max_long_acc'] >= 0.5:\n",
        "        return 'COMPOUND_EVENT'\n",
        "    elif row['jerk'] >= 0.3 and row['max_long_acc'] >= 0.4:\n",
        "        return 'SUDDEN_BRAKE'\n",
        "    elif row['max_lat_acc'] >= 0.4:\n",
        "        return 'SHARP_TURN'\n",
        "    else:\n",
        "        return 'OTHER'\n",
        "\n",
        "df['event_type'] = df.apply(classify_event, axis=1)\n",
        "print('\\nEvent type distribution:')\n",
        "print(df[df['is_edge_case']]['event_type'].value_counts().to_string())\n",
        "\n",
        "# ---- STEP 3: SQL ANALYSIS ----\n",
        "con = duckdb.connect()\n",
        "\n",
        "edge_breakdown = con.execute(f\"\"\"\n",
        "    SELECT\n",
        "        SUM(CASE WHEN is_high_severity    THEN 1 ELSE 0 END) AS high_severity,\n",
        "        SUM(CASE WHEN is_medium_sustained THEN 1 ELSE 0 END) AS medium_sustained,\n",
        "        SUM(CASE WHEN is_peak_long_tail   THEN 1 ELSE 0 END) AS peak_long_tail,\n",
        "        SUM(CASE WHEN is_anomaly          THEN 1 ELSE 0 END) AS top_2pct,\n",
        "        COUNT(*) AS total_frames\n",
        "    FROM '{MERGE_DIR}/final_merged_with_scores.parquet'\n",
        "\"\"\").df()\n",
        "print('\\nEdge case breakdown:')\n",
        "print(edge_breakdown.to_string())\n",
        "\n",
        "top_compound = con.execute(f\"\"\"\n",
        "    SELECT segment_id, intent,\n",
        "           ROUND(max_long_acc, 3)   AS long_acc,\n",
        "           ROUND(max_lat_acc, 3)    AS lat_acc,\n",
        "           ROUND(mean_speed, 1)     AS speed,\n",
        "           ROUND(compound_score, 4) AS severity\n",
        "    FROM '{MERGE_DIR}/final_merged_with_scores.parquet'\n",
        "    WHERE max_long_acc >= 0.5 AND max_lat_acc >= 0.5\n",
        "    ORDER BY compound_score DESC LIMIT 20\n",
        "\"\"\").df()\n",
        "\n",
        "unexpected_swerves = con.execute(f\"\"\"\n",
        "    SELECT segment_id,\n",
        "           ROUND(max_lat_acc, 3)  AS lat_acc,\n",
        "           ROUND(max_long_acc, 3) AS long_acc,\n",
        "           ROUND(mean_speed, 1)   AS speed,\n",
        "           ROUND(jerk, 3)         AS jerk\n",
        "    FROM '{MERGE_DIR}/final_merged_with_scores.parquet'\n",
        "    WHERE intent = 'GO_STRAIGHT' AND max_lat_acc >= 0.4 AND mean_speed >= 10.0\n",
        "    ORDER BY max_lat_acc DESC LIMIT 20\n",
        "\"\"\").df()\n",
        "\n",
        "intent_changes = con.execute(f\"\"\"\n",
        "    WITH lagged AS (\n",
        "        SELECT segment_id, frame_idx, intent, mean_speed,\n",
        "               max_long_acc, max_lat_acc, compound_score,\n",
        "               LAG(intent) OVER (PARTITION BY segment_id ORDER BY frame_idx) AS prev_intent\n",
        "        FROM '{MERGE_DIR}/final_merged_with_scores.parquet'\n",
        "    )\n",
        "    SELECT segment_id, intent, prev_intent,\n",
        "           ROUND(mean_speed, 1)     AS speed,\n",
        "           ROUND(max_long_acc, 3)   AS long_acc,\n",
        "           ROUND(max_lat_acc, 3)    AS lat_acc,\n",
        "           ROUND(compound_score, 4) AS severity\n",
        "    FROM lagged\n",
        "    WHERE intent != prev_intent AND prev_intent IS NOT NULL\n",
        "    AND mean_speed >= 5.0 AND (max_lat_acc >= 0.3 OR max_long_acc >= 0.4)\n",
        "    ORDER BY compound_score DESC LIMIT 20\n",
        "\"\"\").df()\n",
        "\n",
        "df.to_parquet(f'{MERGE_DIR}/final_merged_with_scores.parquet', index=False)\n",
        "print(f'\\nSaved final_merged_with_scores.parquet')\n",
        "\n",
        "# ---- STEP 4: DASHBOARD ----\n",
        "edge_df      = df[df['is_edge_case']].copy()\n",
        "event_counts = df[df['is_edge_case']]['event_type'].value_counts().reset_index()\n",
        "event_counts.columns = ['event_type', 'count']\n",
        "\n",
        "# ---- DESIGN TOKENS ----\n",
        "# blue overall aesthetic\n",
        "BG_DEEP      = '#020c1b'\n",
        "BG_PANEL     = '#0a1628'\n",
        "BG_CARD      = '#0d1f3c'\n",
        "BG_CARD2     = '#112244'\n",
        "BORDER       = '#1a3a6e'\n",
        "BORDER_GLOW  = '#1e6fff'\n",
        "BLUE_PRIMARY = '#1e6fff'\n",
        "BLUE_BRIGHT  = '#4da6ff'\n",
        "BLUE_ACCENT  = '#00d4ff'\n",
        "CYAN_GLOW    = '#00f5ff'\n",
        "RED_ALERT    = '#ff3366'\n",
        "AMBER_WARN   = '#ffb700'\n",
        "GREEN_OK     = '#00e5a0'\n",
        "TEXT_PRIMARY = '#e8f4ff'\n",
        "TEXT_DIM     = '#7aa5cc'\n",
        "TEXT_MUTED   = '#3d6494'\n",
        "\n",
        "# Event type color palette\n",
        "EVENT_COLORS = {\n",
        "    'HARD_BRAKE':       RED_ALERT,\n",
        "    'UNEXPECTED_SWERVE': CYAN_GLOW,\n",
        "    'COMPOUND_EVENT':   AMBER_WARN,\n",
        "    'SUDDEN_BRAKE':     '#ff8c42',\n",
        "    'SHARP_TURN':       '#a78bfa',\n",
        "    'OTHER':            TEXT_MUTED,\n",
        "}\n",
        "\n",
        "# Plotly chart template\n",
        "CHART_TEMPLATE = dict(\n",
        "    paper_bgcolor='rgba(0,0,0,0)',\n",
        "    plot_bgcolor='rgba(10,22,40,0.8)',\n",
        "    font=dict(family='Courier New, monospace', color=TEXT_PRIMARY, size=11),\n",
        "    xaxis=dict(\n",
        "        gridcolor='rgba(30,111,255,0.1)',\n",
        "        zerolinecolor='rgba(30,111,255,0.2)',\n",
        "        linecolor=BORDER\n",
        "    ),\n",
        "    yaxis=dict(\n",
        "        gridcolor='rgba(30,111,255,0.1)',\n",
        "        zerolinecolor='rgba(30,111,255,0.2)',\n",
        "        linecolor=BORDER\n",
        "    ),\n",
        "    legend=dict(\n",
        "        bgcolor='rgba(10,22,40,0.9)',\n",
        "        bordercolor=BORDER,\n",
        "        borderwidth=1\n",
        "    ),\n",
        "    margin=dict(l=40, r=20, t=50, b=40)\n",
        ")\n",
        "\n",
        "def styled_chart(fig, title=''):\n",
        "    fig.update_layout(\n",
        "        **CHART_TEMPLATE,\n",
        "        title=dict(\n",
        "            text=title,\n",
        "            font=dict(\n",
        "                family='Courier New, monospace',\n",
        "                size=13,\n",
        "                color=BLUE_BRIGHT\n",
        "            ),\n",
        "            x=0.01\n",
        "        ),\n",
        "        hoverlabel=dict(\n",
        "            bgcolor=BG_CARD2,\n",
        "            bordercolor=BLUE_PRIMARY,\n",
        "            font=dict(family='Courier New, monospace', color=TEXT_PRIMARY)\n",
        "        )\n",
        "    )\n",
        "    return fig\n",
        "\n",
        "# Build charts\n",
        "fig_events = styled_chart(px.bar(\n",
        "    event_counts, x='event_type', y='count',\n",
        "    color='event_type',\n",
        "    color_discrete_map=EVENT_COLORS,\n",
        "), title='// EVENT CLASSIFICATION')\n",
        "fig_events.update_traces(marker_line_width=0)\n",
        "\n",
        "fig_scatter = styled_chart(px.scatter(\n",
        "    edge_df,\n",
        "    x='mean_speed', y='max_long_acc',\n",
        "    color='event_type',\n",
        "    color_discrete_map=EVENT_COLORS,\n",
        "    size='compound_score',\n",
        "    hover_data=['segment_id', 'intent', 'max_lat_acc', 'jerk'],\n",
        "), title='// SPEED vs BRAKING INTENSITY')\n",
        "\n",
        "fig_pie = go.Figure(go.Pie(\n",
        "    labels=edge_df['intent'].value_counts().index,\n",
        "    values=edge_df['intent'].value_counts().values,\n",
        "    hole=0.65,\n",
        "    marker=dict(\n",
        "        colors=[BLUE_PRIMARY, BLUE_ACCENT, CYAN_GLOW],\n",
        "        line=dict(color=BG_DEEP, width=3)\n",
        "    ),\n",
        "    textfont=dict(family='Courier New, monospace', color=TEXT_PRIMARY)\n",
        "))\n",
        "fig_pie.update_layout(\n",
        "    **CHART_TEMPLATE,\n",
        "    title=dict(\n",
        "        text='// INTENT DISTRIBUTION',\n",
        "        font=dict(family='Courier New, monospace', size=13, color=BLUE_BRIGHT),\n",
        "        x=0.01\n",
        "    ),\n",
        "    showlegend=True\n",
        ")\n",
        "\n",
        "fig_hist = go.Figure(go.Histogram(\n",
        "    x=df['compound_score'],\n",
        "    nbinsx=50,\n",
        "    marker=dict(\n",
        "        color=BLUE_PRIMARY,\n",
        "        line=dict(color=BLUE_ACCENT, width=0.5)\n",
        "    ),\n",
        "    opacity=0.85\n",
        "))\n",
        "fig_hist.add_vline(\n",
        "    x=threshold,\n",
        "    line_dash='dash',\n",
        "    line_color=RED_ALERT,\n",
        "    annotation_text=f' 98th pct: {threshold:.3f}',\n",
        "    annotation_font=dict(color=RED_ALERT, family='Courier New, monospace', size=11)\n",
        ")\n",
        "fig_hist = styled_chart(fig_hist, title='// SEVERITY SCORE DISTRIBUTION')\n",
        "\n",
        "fig_persons = styled_chart(px.bar(\n",
        "    df.groupby('person_id').size().reset_index(name='frames'),\n",
        "    x='person_id', y='frames',\n",
        "    color_discrete_sequence=[BLUE_PRIMARY]\n",
        "), title='// FRAMES PER ANALYST')\n",
        "fig_persons.update_traces(marker_line_width=0)\n",
        "\n",
        "# ---- TABLE STYLE ----\n",
        "TABLE_STYLE = dict(\n",
        "    style_table={'overflowX': 'auto', 'border': f'1px solid {BORDER}'},\n",
        "    style_cell={\n",
        "        'backgroundColor': BG_PANEL,\n",
        "        'color': TEXT_PRIMARY,\n",
        "        'fontSize': '11px',\n",
        "        'fontFamily': 'Courier New, monospace',\n",
        "        'border': f'1px solid {BORDER}',\n",
        "        'padding': '8px 12px',\n",
        "    },\n",
        "    style_header={\n",
        "        'backgroundColor': BG_CARD2,\n",
        "        'color': BLUE_BRIGHT,\n",
        "        'fontWeight': 'bold',\n",
        "        'fontFamily': 'Courier New, monospace',\n",
        "        'fontSize': '11px',\n",
        "        'border': f'1px solid {BORDER_GLOW}',\n",
        "        'letterSpacing': '0.08em',\n",
        "        'textTransform': 'uppercase',\n",
        "    },\n",
        "    style_data_conditional=[\n",
        "        {\n",
        "            'if': {'filter_query': '{is_peak_long_tail} = True'},\n",
        "            'backgroundColor': 'rgba(255,51,102,0.12)',\n",
        "            'color': RED_ALERT,\n",
        "            'borderLeft': f'3px solid {RED_ALERT}',\n",
        "        },\n",
        "        {\n",
        "            'if': {'filter_query': '{compound_score} > ' + str(round(threshold, 4))},\n",
        "            'backgroundColor': 'rgba(0,229,160,0.08)',\n",
        "            'color': GREEN_OK,\n",
        "            'borderLeft': f'3px solid {GREEN_OK}',\n",
        "        },\n",
        "        {\n",
        "            'if': {'row_index': 'odd'},\n",
        "            'backgroundColor': 'rgba(30,111,255,0.04)',\n",
        "        },\n",
        "    ],\n",
        "    sort_action='native',\n",
        "    filter_action='native',\n",
        "    page_size=12,\n",
        ")\n",
        "\n",
        "# ---- CARD STYLE HELPER ----\n",
        "def stat_card(value, label, color, icon=''):\n",
        "    return dbc.Col(html.Div([\n",
        "        html.Div(style={\n",
        "            'position': 'absolute', 'top': 0, 'left': 0, 'right': 0, 'bottom': 0,\n",
        "            'background': f'linear-gradient(135deg, {color}18 0%, transparent 60%)',\n",
        "            'borderRadius': '8px',\n",
        "            'pointerEvents': 'none',\n",
        "        }),\n",
        "        html.Div(f'{icon}', style={\n",
        "            'fontSize': '22px', 'marginBottom': '4px', 'opacity': '0.7'\n",
        "        }),\n",
        "        html.Div(f'{value}', style={\n",
        "            'fontSize': '32px',\n",
        "            'fontWeight': '700',\n",
        "            'fontFamily': 'Courier New, monospace',\n",
        "            'color': color,\n",
        "            'letterSpacing': '-0.02em',\n",
        "            'lineHeight': '1',\n",
        "        }),\n",
        "        html.Div(label, style={\n",
        "            'fontSize': '10px',\n",
        "            'color': TEXT_DIM,\n",
        "            'fontFamily': 'Courier New, monospace',\n",
        "            'letterSpacing': '0.15em',\n",
        "            'textTransform': 'uppercase',\n",
        "            'marginTop': '6px',\n",
        "        }),\n",
        "    ], style={\n",
        "        'backgroundColor': BG_CARD,\n",
        "        'border': f'1px solid {BORDER}',\n",
        "        'borderTop': f'2px solid {color}',\n",
        "        'borderRadius': '8px',\n",
        "        'padding': '20px 16px',\n",
        "        'position': 'relative',\n",
        "        'overflow': 'hidden',\n",
        "    }), width=2)\n",
        "\n",
        "# ---- GLOBAL STYLES ----\n",
        "GLOBAL_CSS = f\"\"\"\n",
        "    @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;700&display=swap');\n",
        "\n",
        "    body {{\n",
        "        background-color: {BG_DEEP} !important;\n",
        "        background-image:\n",
        "            radial-gradient(ellipse at 20% 50%, rgba(30,111,255,0.06) 0%, transparent 60%),\n",
        "            radial-gradient(ellipse at 80% 20%, rgba(0,212,255,0.04) 0%, transparent 50%);\n",
        "        background-attachment: fixed;\n",
        "    }}\n",
        "\n",
        "    .container-fluid {{ background: transparent !important; }}\n",
        "\n",
        "    .dash-tab {{\n",
        "        background-color: {BG_PANEL} !important;\n",
        "        border: 1px solid {BORDER} !important;\n",
        "        color: {TEXT_DIM} !important;\n",
        "        font-family: 'Share Tech Mono', monospace !important;\n",
        "        font-size: 11px !important;\n",
        "        letter-spacing: 0.1em !important;\n",
        "        padding: 10px 18px !important;\n",
        "    }}\n",
        "    .dash-tab--selected {{\n",
        "        background-color: {BG_CARD2} !important;\n",
        "        border-bottom: 2px solid {BLUE_ACCENT} !important;\n",
        "        color: {BLUE_BRIGHT} !important;\n",
        "    }}\n",
        "    .tab-content {{\n",
        "        background-color: {BG_PANEL} !important;\n",
        "        border: 1px solid {BORDER} !important;\n",
        "        border-top: none !important;\n",
        "        padding: 16px !important;\n",
        "    }}\n",
