        "# -----------------------------------------------------------------\n",
        "# CELL 2: THE SETTINGS\n",
        "# IMPORTANT: Each person changes only PERSON_ID before running (Please run your assigned tasks)\n",
        "# Everything else is calculated automatically\n",
        "# -----------------------------------------------------------------\n",
        "\n",
        "# ---- CHANGE THIS TO YOUR NUMBER ----\n",
        "PERSON_ID = 4   # 1(Alden), 2, 3, 4(Jasmine), or 5\n",
        "# ------------------------------------\n",
        "\n",
        "# File range is set automatically from PERSON_ID\n",
        "FILE_RANGES = {\n",
        "    1: (0,   5),   # files 00000–00004\n",
        "    2: (5,   10),  # files 00005–00009\n",
        "    3: (10,  15),  # files 00010–00014\n",
        "    4: (15,  20),  # files 00015–00019\n",
        "    5: (20,  25),  # files 00020–00024\n",
        "}\n",
        "START_FILE, END_FILE = FILE_RANGES[PERSON_ID]\n",
        "\n",
        "# Shared Drive folder: it must be the same for all team members\n",
        "BASE_DIR   = '/content/drive/MyDrive/waymo_env_final'\n",
        "OUTPUT_DIR = f'{BASE_DIR}/person_{PERSON_ID}'\n",
        "MERGE_DIR  = f'{BASE_DIR}/merged'\n",
        "\n",
        "# Create the output folders\n",
        "os.makedirs(f'{OUTPUT_DIR}/parquets',      exist_ok=True)\n",
        "os.makedirs(f'{OUTPUT_DIR}/images',        exist_ok=True)\n",
        "os.makedirs(f'{OUTPUT_DIR}/images_smooth', exist_ok=True)\n",
        "os.makedirs(f'{OUTPUT_DIR}/gifs',          exist_ok=True)\n",
        "os.makedirs(f'{OUTPUT_DIR}/gifs_smooth',   exist_ok=True)\n",
        "os.makedirs(MERGE_DIR,                     exist_ok=True)\n",
        "\n",
        "# ---- DETECTION THRESHOLDS ----\n",
        "# Calibrated from 39,335 merged frames\n",
        "# Values are normalized (0–2 range), not raw m/s²\n",
        "# Proposed way: use percentiles?\n",
        "# 95th percentile = top 5% of all frames = notable event\n",
        "# 99th percentile = top 1% of all frames = extreme event\n",
        "HARD_BRAKE_THRESHOLD = 0.611   # 95th pct longitudinal acceleration\n",
        "EMERGENCY_BRAKE      = 0.798   # 99th pct longitudinal acceleration\n",
        "HIGH_LAT_THRESHOLD   = 0.445   # 95th pct lateral acceleration\n",
        "HIGH_JERK_THRESHOLD  = 0.287   # 95th pct jerk\n",
        "\n",
        "# Rolling window thresholds — slightly lower than single-frame thresholds\n",
        "# because we require the signal to be sustained, not just a single spike\n",
        "SUSTAINED_BRAKE_SHORT   = 0.527\n",
        "SUSTAINED_LATERAL_SHORT = 0.445\n",
        "SUSTAINED_JERK_SHORT    = 0.287\n",
        "SUSTAINED_BRAKE_MEDIUM  = 0.570\n",
        "SUSTAINED_JERK_MEDIUM   = 0.260\n",
        "\n",
        "# ---- ROLLING BUFFER SETTINGS ----\n",
        "# Dataset is 10 Hz: 10 frames per second\n",
        "# Buffer holds the last N frames in memory per segment\n",
        "# When an edge case is detected:\n",
        "#   - buffer is flushed to disk = pre-event footage saved\n",
        "#   - POST_EVENT_FRAMES are also saved = post-event footage\n",
        "FRAME_BUFFER_SIZE = 25   # 2.5 seconds of pre-event context\n",
        "POST_EVENT_FRAMES = 25   # 2.5 seconds of post-event context\n",
        "MIN_GIF_FRAMES    = 10   # skip making a GIF if fewer frames than this\n",
        "\n",
        "# ---- SMOOTH GIF SETTINGS (used in Cells 7 and 8) ----\n",
        "MIN_CONSECUTIVE_FRAMES = 100  # minimum frames for a smooth GIF (10 seconds)\n",
        "CONTEXT_BEFORE         = 100  # frames to include before first flagged frame\n",
        "CONTEXT_AFTER          = 100  # frames to include after last flagged frame\n",
        "MAX_ALLOWED_GAP        = 3    # max frame index gap allowed in a smooth GIF\n",
        "TOP_SEGMENTS_COUNT     = 20   # how many top segments to scan all 263 files for\n",
        "\n",
        "print(f'Person {PERSON_ID} — files {START_FILE} to {END_FILE - 1}')\n",
        "print(f'Output: {OUTPUT_DIR}')"
      ]
    },
