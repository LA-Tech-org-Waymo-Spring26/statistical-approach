      "source": [
        "# --------------------------------------------------------------------\n",
        "# CELL 8 — SCAN ALL 263 FILES FOR TARGET SEGMENTS\n",
        "# Collects every frame belonging to the top 20 segments\n",
        "# so we can build smooth long GIFs around each edge case\n",
        "#\n",
        "# This takes ~6-8 hours, leave it running overnight\n",
        "#\n",
        "# Checkpoints to Drive every 10,000 frames — safe to restart\n",
        "# if it disconnects, already-saved frames are skipped on resume\n",
        "# --------------------------------------------------------------------\n",
        "\n",
        "# Build complete file list: all 263 files\n",
        "all_filenames = [\n",
        "    f'gs://waymo_open_dataset_end_to_end_camera_v_1_0_0/'\n",
        "    f'training_202504031202_202504151040.tfrecord-{str(i).zfill(5)}-of-00263'\n",
        "    for i in range(0, 263)\n",
        "]\n",
        "\n",
        "# Initialize buffer: reload any frames already saved from a previous run\n",
        "segment_frame_buffer = {seg_id: [] for seg_id in target_segments}\n",
        "already_saved = 0\n",
        "\n",
        "print('Checking for frames saved from previous runs...')\n",
        "for seg_id in target_segments:\n",
        "    seg_dir  = f'{OUTPUT_DIR}/images_smooth/{seg_id}/FRONT'\n",
        "    existing = sorted(\n",
        "        glob.glob(f'{seg_dir}/camera_image_*.jpg'),\n",
        "        key=lambda x: int(os.path.splitext(os.path.basename(x))[0].replace('camera_image_', ''))\n",
        "    ) if os.path.exists(seg_dir) else []\n",
        "    for p in existing:\n",
        "        with open(p, 'rb') as f:\n",
        "            segment_frame_buffer[seg_id].append({\n",
        "                'frame_idx':   int(os.path.splitext(os.path.basename(p))[0].replace('camera_image_', '')),\n",
        "                'image_bytes': f.read()\n",
        "            })\n",
        "    if existing:\n",
        "        print(f'  {seg_id[-8:]}... reloaded {len(existing)} frames')\n",
        "        already_saved += len(existing)\n",
        "\n",
        "print(f'Reloaded {already_saved} frames from previous run\\n')\n",
        "print(f'Scanning all 263 files for {len(target_segments)} segments...')\n",
        "print('Checkpointing to Drive every 10,000 frames\\n')\n",
        "\n",
        "full_dataset = tf.data.TFRecordDataset(all_filenames, compression_type='', num_parallel_reads=1)\n",
        "\n",
        "frames_checked   = 0\n",
        "frames_collected = 0\n",
        "\n",
        "for raw in full_dataset:\n",
        "    raw_bytes = raw.numpy()\n",
        "    frames_checked += 1\n",
        "\n",
        "    # Progress + checkpoint every 10,000 frames\n",
        "    if frames_checked % 10000 == 0:\n",
        "        print(f'  Checked {frames_checked:,} | collected {frames_collected} frames...')\n",
        "        checkpoint_saved = 0\n",
        "        for seg_id, frames in segment_frame_buffer.items():\n",
        "            if not frames: continue\n",
        "            seg_dir = f'{OUTPUT_DIR}/images_smooth/{seg_id}/FRONT'\n",
        "            os.makedirs(seg_dir, exist_ok=True)\n",
        "            for frame in frames:\n",
        "                if frame['image_bytes'] is None: continue\n",
        "                img_path = f'{seg_dir}/camera_image_{frame[\"frame_idx\"]:04d}.jpg'\n",
        "                if not os.path.exists(img_path):\n",
        "                    with open(img_path, 'wb') as f: f.write(frame['image_bytes'])\n",
        "                    checkpoint_saved += 1\n",
        "        print(f'  Checkpoint: {checkpoint_saved} new frames saved to Drive')\n",
        "\n",
        "    # Cheap byte check before full proto parse — much faster\n",
        "    matched = None\n",
        "    for seg_id in target_segments:\n",
        "        if seg_id.encode() in raw_bytes:\n",
        "            matched = seg_id\n",
        "            break\n",
        "    if matched is None:\n",
        "        continue\n",
        "\n",
        "    # Full parse only for matching frames\n",
        "    e2e        = e2e_pb2.E2EDFrame()\n",
        "    e2e.ParseFromString(raw_bytes)\n",
        "    frame_id   = e2e.frame.context.name\n",
        "    segment_id = frame_id.split('-')[0]\n",
        "    frame_idx  = int(frame_id.split('-')[1])\n",
        "\n",
        "    if segment_id not in target_segments:\n",
        "        continue\n",
        "\n",
        "    # Skip frames already saved from a previous run\n",
        "    seg_dir  = f'{OUTPUT_DIR}/images_smooth/{segment_id}/FRONT'\n",
        "    img_path = f'{seg_dir}/camera_image_{frame_idx:04d}.jpg'\n",
        "    if os.path.exists(img_path):\n",
        "        continue\n",
        "\n",
        "    front_image = None\n",
        "    for img_proto in e2e.frame.images:\n",
        "        if img_proto.name == 1:\n",
        "            front_image = img_proto.image\n",
        "            break\n",
        "\n",
        "    segment_frame_buffer[segment_id].append({'frame_idx': frame_idx, 'image_bytes': front_image})\n",
        "    frames_collected += 1\n",
        "\n",
        "# Final save to Drive\n",
        "print('\\nFinal save to Drive...')\n",
        "for seg_id, frames in segment_frame_buffer.items():\n",
        "    if not frames: continue\n",
        "    seg_dir = f'{OUTPUT_DIR}/images_smooth/{seg_id}/FRONT'\n",
        "    os.makedirs(seg_dir, exist_ok=True)\n",
        "    for frame in frames:\n",
        "        if frame['image_bytes'] is None: continue\n",
        "        img_path = f'{seg_dir}/camera_image_{frame[\"frame_idx\"]:04d}.jpg'\n",
        "        if not os.path.exists(img_path):\n",
        "            with open(img_path, 'wb') as f: f.write(frame['image_bytes'])\n",
        "\n",
        "# Save JSON index — lightweight record of which frames were collected\n",
        "buffer_index = {seg_id: sorted([f['frame_idx'] for f in frames]) for seg_id, frames in segment_frame_buffer.items()}\n",
        "with open(f'{OUTPUT_DIR}/segment_buffer_index.json', 'w') as f:\n",
        "    json.dump(buffer_index, f, indent=2)\n",
        "\n",
        "print(f'\\nScan complete:')\n",
        "print(f'  Frames checked:  {frames_checked:,}')\n",
        "print(f'  Frames collected:{frames_collected}')\n",
        "print(f'\\nFrames per segment:')\n",
        "for seg_id, frames in sorted(segment_frame_buffer.items(), key=lambda x: len(x[1]), reverse=True):\n",
        "    print(f'  {seg_id[-8:]}... — {len(frames)} frames')"
      ]
    },
