        "# ----------------------------------------------------------------\n",
        "# CELL 7: FIND TOP 20 SEGMENTS WITH MULTIPLE DISTINCT EVENTS\n",
        "# Requires at least 2 separate edge case events in the same segment\n",
        "# An \"event\" is a cluster of flagged frames separated by a gap\n",
        "# This filters out single spikes (potholes) and keeps real scenarios\n",
        "# like: hard stop THEN swerve, or repeated hard braking\n",
        "# ----------------------------------------------------------------\n",
        "\n",
        "def count_distinct_events(group, min_gap=10):\n",
        "    \"\"\"\n",
        "    Counts how many separate edge case events exist in a segment.\n",
        "    Frames within min_gap of each other = same event.\n",
        "    Frames more than min_gap apart = separate events.\n",
        "    min_gap=10 means events must be at least 1 second apart at 10Hz.\n",
        "    \"\"\"\n",
        "    flagged_indices = sorted(group[group['is_edge_case']]['frame_idx'].tolist())\n",
        "    if not flagged_indices:\n",
        "        return 0\n",
        "    events = 1\n",
        "    for i in range(1, len(flagged_indices)):\n",
        "        if flagged_indices[i] - flagged_indices[i-1] > min_gap:\n",
        "            events += 1\n",
        "    return events\n",
        "\n",
        "def describe_event_sequence(group, min_gap=10):\n",
        "    \"\"\"\n",
        "    Returns a readable description of what events occurred and in what order.\n",
        "    e.g. 'BRAKE -> SWERVE' or 'BRAKE -> BRAKE'\n",
        "    \"\"\"\n",
        "    edge_frames = group[group['is_edge_case']].sort_values('frame_idx')\n",
        "    if edge_frames.empty:\n",
        "        return ''\n",
        "\n",
        "    events  = []\n",
        "    current = [edge_frames.iloc[0]]\n",
        "\n",
        "    for i in range(1, len(edge_frames)):\n",
        "        gap = edge_frames.iloc[i]['frame_idx'] - edge_frames.iloc[i-1]['frame_idx']\n",
        "        if gap > min_gap:\n",
        "            events.append(current)\n",
        "            current = []\n",
        "        current.append(edge_frames.iloc[i])\n",
        "    events.append(current)\n",
        "\n",
        "    labels = []\n",
        "    for event in events:\n",
        "        event_df = pd.DataFrame(event)\n",
        "        max_long = event_df['max_long_acc'].max()\n",
        "        max_lat  = event_df['max_lat_acc'].max()\n",
        "        if max_long >= EMERGENCY_BRAKE:\n",
        "            labels.append('HARD_BRAKE')\n",
        "        elif max_lat >= HIGH_LAT_THRESHOLD and max_long >= HARD_BRAKE_THRESHOLD:\n",
        "            labels.append('BRAKE+SWERVE')\n",
        "        elif max_lat >= HIGH_LAT_THRESHOLD:\n",
        "            labels.append('SWERVE')\n",
        "        else:\n",
        "            labels.append('BRAKE')\n",
        "    return ' -> '.join(labels)\n",
        "\n",
        "# Count distinct events per segment\n",
        "print('Counting distinct events per segment...')\n",
        "event_counts = df.groupby('segment_id').apply(\n",
        "    lambda g: count_distinct_events(g, min_gap=10)\n",
        ").reset_index()\n",
        "event_counts.columns = ['segment_id', 'event_count']\n",
        "\n",
        "# Only keep segments with 2 or more distinct events\n",
        "multi_event_segs = event_counts[event_counts['event_count'] >= 2]['segment_id'].tolist()\n",
        "print(f'Segments with 2+ distinct events: {len(multi_event_segs)}')\n",
        "\n",
        "# Only consider segments where the car was actually moving\n",
