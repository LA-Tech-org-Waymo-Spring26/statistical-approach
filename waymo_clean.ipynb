        "    (df['mean_speed'] >= 5.0)  # at least 5 m/s (~11 mph)\n",
        "]\n",
        "\n",
        "top_segments = filtered_df[filtered_df['is_edge_case']].groupby('segment_id').agg(\n",
        "    max_severity  = ('max_long_acc',      'max'),\n",
        "    max_lat       = ('max_lat_acc',       'max'),\n",
        "    mean_speed    = ('mean_speed',        'mean'),\n",
        "    frame_count   = ('frame_id',          'count'),\n",
        "    intents       = ('intent',            lambda x: list(x.unique())),\n",
        "    peak_long_tail= ('is_peak_long_tail', 'any')\n",
        ").sort_values('max_severity', ascending=False).head(TOP_SEGMENTS_COUNT)\n",
        "\n",
        "# Add event count and sequence description\n",
        "top_segments['event_count'] = top_segments.index.map(\n",
        "    event_counts.set_index('segment_id')['event_count']\n",
        ")\n",
        "top_segments['sequence'] = top_segments.index.map(\n",
        "    lambda seg_id: describe_event_sequence(\n",
        "        df[df['segment_id'] == seg_id], min_gap=10\n",
        "    )\n",
        ")\n",
        "\n",
        "print(f'\\nTop {len(top_segments)} multi-event segments (speed >= 5 m/s):')\n",
        "print(top_segments[[\n",
        "    'max_severity', 'max_lat', 'mean_speed',\n",
        "    'event_count', 'sequence', 'peak_long_tail'\n",
        "]].to_string())\n",
        "\n",
        "target_segments = set(top_segments.index.tolist())\n",
        "print(f'\\nWill scan all 263 files for {len(target_segments)} segments')"
