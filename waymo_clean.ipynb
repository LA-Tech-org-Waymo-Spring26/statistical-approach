        "# -----------------------------------------------------------------\n",
        "# CELL 1: THE ENVIRONMENT SETUP\n",
        "# Run this first every session!\n",
        "# After it finishes: restart runtime, then run it again\n",
        "# Then run all remaining cells top to bottom\n",
        "# -----------------------------------------------------------------\n",
        "\n",
        "# Waymo package — tf-2-12-0 is required, other versions break proto parsing\n",
        "!pip install -q waymo-open-dataset-tf-2-12-0==1.6.7 --no-deps\n",
        "\n",
        "# Mount Google Drive: all outputs will be saved here\n",
        "# Everyone must use the same shared Drive folder so parquets merge correctly (Need to make a shared folder)\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Authenticate with Google Cloud to read from the Waymo GCS bucket\n",
        "from google.colab import auth\n",
        "auth.authenticate_user()\n",
        "\n",
        "import subprocess\n",
        "subprocess.run(['gcloud', 'config', 'set', 'project', 'waymo-project-493504'], check=True)\n",
        "\n",
        "# Core libraries needed for this task\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import os\n",
        "import glob\n",
        "import json\n",
        "import duckdb\n",
        "import shutil\n",
        "from PIL import Image\n",
        "from collections import defaultdict, deque\n",
        "\n",
        "# Waymo proto: defines the structure of each frame in the dataset\n",
        "from waymo_open_dataset.protos import end_to_end_driving_data_pb2 as e2e_pb2\n",
        "\n",
        "print('TF version:', tf.__version__)\n",
        "print('Setup complete')"
      ]
    },
